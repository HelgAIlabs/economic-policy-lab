    { "source": "/login/index.html", "destination": "/login", "permanent": true },
    { "source": "/auth/index.html", "destination": "/auth", "permanent": true },
    { "source": "/member/index.html", "destination": "/member", "permanent": true },
    { "source": "/member/write/index.html", "destination": "/member/write", "permanent": true },
    { "source": "/admin/index.html", "destination": "/admin", "permanent": true },
